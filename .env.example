# Variabili pubbliche Supabase (esposte al browser solo per Auth SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Variabili private lato server (MAI prefissare con NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-google-ai-studio-api-key
LLAMAPARSE_API_KEY=your-llamaindex-api-key

# Configurazione opzionale modelli Gemini e soglia pertinenza RAG
GEMINI_MODEL_ECO=gemini-3.5-flash-lite
GEMINI_MODEL_ADVANCED=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_MATCH_THRESHOLD=0.55
